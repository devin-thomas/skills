{
  "name": "@uppercut-labs/skills",
  "version": "0.0.0",
  "private": true,
  "description": "Install and manage Uppercut Labs agent skills",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "uppercut-skills": "./bin/uppercut-skills.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-native": {
      "types": "./dist/agent-native/index.d.ts",
      "import": "./dist/agent-native/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "files": ["dist", "bin", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test",
    "smoke": "node ../../distribution/smoke-package.mjs"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "2.3.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": { "optional": true }
  },
  "dependencies": {
    "@uppercut-labs/agent-native": "0.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "@types/node": "22.20.5",
    "typescript": "5.8.3"
  }
}
