{
  "name": "web-three-systems-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "electron:install": "node node_modules/electron/install.js",
    "tokens": "node tokens/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p qa/tsconfig.json",
    "build": "node tokens/build.ts && node scripts/build-electron.ts && vite build",
    "build:electron": "node scripts/build-electron.ts",
    "emit:plain": "node scripts/emit-plain-node.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "shell:check": "node scripts/build-electron.ts && node measure/shell-check.ts",
    "shell:evidence": "node measure/shell-evidence.ts",
    "start": "node scripts/build-electron.ts && node measure/shell-check.ts && electron . --no-activate --data-dir=qa/data/dev",
    "qa:audit": "node qa/audit.ts",
    "qa:shots": "node qa/shots.ts",
    "qa:kill": "node qa/kill-test.ts",
    "qa:typing": "node qa/typing.ts",
    "qa:crash": "node qa/crash-test.ts",
    "qa:theme": "node qa/theme-start.ts",
    "qa:visual": "node qa/visual.ts",
    "qa:planted": "node qa/planted-breaks.ts",
    "fuses:check": "node scripts/fuses-check.ts",
    "measure:focus": "node measure/focus-experiment.ts",
    "measure:memory": "node measure/memory-experiment.ts",
    "icon": "node scripts/make-icon.ts",
    "stage": "node scripts/stage.ts",
    "package": "node scripts/package.ts",
    "package:win": "node scripts/package.ts win32-x64",
    "package:mac": "node scripts/package.ts darwin-arm64",
    "package:linux-arm64": "node scripts/package.ts linux-arm64",
    "package:linux-x64": "node scripts/package.ts linux-x64"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-virtual": "3.14.26",
    "lucide-react": "1.70.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.1.2",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "25.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uppercut-labs/app-icon-generator": "0.1.0",
    "@uppercut-labs/browser-qa-harness": "0.1.0",
    "@uppercut-labs/electron-bridge-test-double": "0.1.0",
    "@uppercut-labs/electron-child-process-runner": "0.2.0",
    "@uppercut-labs/electron-command-menu": "0.1.0",
    "@uppercut-labs/electron-control-channel": "0.1.0",
    "@uppercut-labs/electron-private-memory": "0.1.0",
    "@uppercut-labs/electron-qa-measurements": "0.1.1",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "45.3.2",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.65.1",
    "pngjs": "7.0.0",
    "rolldown": "1.2.19",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "productName": "Starter",
  "description": "Starter content app",
  "main": "dist/electron/main.mjs"
}
