{
  "name": "web-three-systems-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "electron:install": "node node_modules/electron/install.js",
    "tokens": "node tokens/build.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node tokens/build.mjs && vite build",
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "shell:check": "node measure/shell-check.mjs",
    "shell:evidence": "node measure/shell-evidence.mjs",
    "start": "node measure/shell-check.mjs && electron . --no-activate --data-dir=qa/data/dev",
    "qa:audit": "node qa/audit.mjs",
    "qa:shots": "node qa/shots.mjs",
    "qa:kill": "node qa/kill-test.mjs",
    "qa:typing": "node qa/typing.mjs",
    "measure:focus": "node measure/focus-experiment.mjs",
    "measure:memory": "node measure/memory-experiment.mjs",
    "icon": "node scripts/make-icon.mjs",
    "stage": "node scripts/stage.mjs",
    "package": "node scripts/package.mjs",
    "package:win": "node scripts/package.mjs win32-x64",
    "package:mac": "node scripts/package.mjs darwin-arm64",
    "package:linux-arm64": "node scripts/package.mjs linux-arm64",
    "package:linux-x64": "node scripts/package.mjs linux-x64"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-virtual": "3.14.26",
    "lucide-react": "1.70.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.1.2",
    "@electron/packager": "20.3.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "25.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "45.3.2",
    "playwright-core": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "productName": "Starter",
  "description": "Starter content app",
  "main": "electron/main.cjs"
}
